<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item>
        <selector>
            <item
                android:state_activated="true"
                app:state_multiselected="true">
                <shape>
                    <solid android:color="?attr/colorSurfaceVariant" />
                    <stroke android:width="1dp" android:color="?attr/colorPrimary" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="?attr/colorSurfaceVariant" />
                    <stroke android:width="1dp" android:color="@color/md_theme_dark_primaryContainer" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/panel_card_background" />
        </selector>
    </item>
    <item android:drawable="?attr/selectableItemBackground" />
</layer-list>
